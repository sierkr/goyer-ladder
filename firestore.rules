rules_version = '2';
// ============================================================
//  Goyer Golf MP Ladder - Firestore security rules v5.0.0
// ------------------------------------------------------------
//  WIJZIGINGEN v5.0.0 (lees dit voor je publiceert):
//
//  1. ladder/watchPins is VOLLEDIG dichtgezet (read en write op false).
//     Dit document stond op `allow read: if true` en bevatte Firebase
//     refreshTokens - permanente sleutels waarmee iedereen ter wereld kon
//     inloggen als elke speler. Het horloge logt nu in via de Cloud Functions
//     maakWatchPin / wisselWatchPin, die als enige (via de Admin SDK) nog bij
//     dit document komen. Ook nieuw: ladder/watchPinPogingen (foutteller).
//
//  3. ladders/{id}/standen/{uid} is READ-ONLY voor clients geworden. De
//     zichtbare positie was tot v4.2.0 door elk ladderlid te overschrijven,
//     voor elke speler - terwijl de afgeschermde punten wel op slot zaten.
//     Alle schrijfacties lopen nu via de Cloud Functions.
//
//  4. NIEUW: ladders/{id}/partijen/{partijId} met subcollectie scores/{uid}.
//     Scores stonden in een array in het ladderdocument, waardoor elke
//     toetsaanslag de complete array van de hele ladder terugschreef en twee
//     flights elkaars holes wisten. Elke speler heeft nu een eigen
//     scoredocument; botsen kan structureel niet meer.
//     Ook nieuw: ladders/{id}/verwerkt/{partijId} (idempotency-stempel van
//     verwerkPartijUitslag) en ladders/{id}/teruggedraaid/{partijId} -
//     allebei alleen door de Cloud Functions beschreven.
// ============================================================
// Goyer Golf MP Ladder - Firestore security rules v3.0.0-10 (fase 10 V-2)
// Wijzigingen t.o.v. v2:
//  - ladder/{doc}: write gesplitst per doc-type. Coordinator-only voor archief,
//    uitdagingen, ladderVolgorde, banen, state. Elke speler mag eigen uitdaging-entry
//    toevoegen/verwijderen. Invite-docs mogen alleen door coordinator aangemaakt;
//    teller mag door iedere ingelogde +1 tijdens registratie.
//  - uitslagen/{doc}: create open voor ingelogde, update/delete alleen coordinator
//    (voorkomt dat speler andermans uitslagen overschrijft).
//  - toernooien/{doc}: read blijft publiek (live meekijken), write alleen coordinator.
//    Subcollectie live scores blijft open voor elke ingelogde speler, BEHALVE de
//    laag `beheerDagen` (v5.11.0): die stelt een score definitief vast en is
//    daarom alleen voor de coordinator.
//  - snapshots/{doc}: read alleen coordinator (bevat volledige ladderstanden +
//    speler-identiteit - niet gedeeld met iedere speler).
//  - ladders/{id}/standen/{uid}: write door elke ingelogde speler die in de ladder
//    zit (nodig voor syncStandenNaBevestigUitslag). Delete blijft coordinator.
//  - v4.2.0: ladders/{id}/punten/{uid} toegevoegd (puntensysteem). Read alleen
//    voor het puntenBeheerder-account; write voor niemand rechtstreeks — alle
//    schrijfacties lopen via Cloud Functions (Admin SDK). LET OP: het veld
//    puntenBeheerder:true moet handmatig op één spelers/{uid}-document worden
//    gezet via de Firebase console — zie _project.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---------------------------------------------
    function isIngelogd() {
      return request.auth != null;
    }
    // Lees spelers/{uid} robuust - null als doc niet bestaat
    function getSpelerData(uid) {
      return exists(/databases/$(database)/documents/spelers/$(uid))
        ? get(/databases/$(database)/documents/spelers/$(uid)).data
        : null;
    }
    function isBeheerder() {
      return isIngelogd() &&
        getSpelerData(request.auth.uid) != null &&
        getSpelerData(request.auth.uid).rol == 'beheerder';
    }
    function isCoordinator() {
      return isIngelogd() &&
        getSpelerData(request.auth.uid) != null &&
        (getSpelerData(request.auth.uid).rol == 'coordinator' ||
         getSpelerData(request.auth.uid).rol == 'beheerder');
    }
    // ============================================================
    //  v5.38.0 — DE TOERNOOI-PINCODE
    // ------------------------------------------------------------
    //  Wie via de pincode van een toernooi binnenkomt, krijgt van de server
    //  een sessie met de stempel `viaPin`. Zo iemand heeft NIET zijn eigen
    //  wachtwoord gebruikt: één getal van vier cijfers, gedeeld met de hele
    //  flight, gaf toegang. Daarom mag zo'n sessie alleen aan het toernooi
    //  komen en nergens anders aan.
    //
    //  ⚠ Dit is de grendel die het gedeelde getal draaglijk maakt. Verdwijnt
    //  hij, dan kan iedereen die de pincode hoort onder de naam van een clublid
    //  de ladderstand veranderen. Het verbergen van knoppen in de app is geen
    //  vervanging: dat houdt niemand tegen die de database rechtstreeks aanroept.
    //
    //  `.get('viaPin', false)`: een claim die niet bestaat opvragen is in
    //  Firestore-regels een FOUT en geen lege waarde — en een regel die een
    //  fout geeft, weigert. Dat zou elke gewone inlog blokkeren.
    // ============================================================
    function viaToernooiPin() {
      return isIngelogd() && request.auth.token.get('viaPin', false) == true;
    }
    // ============================================================
    //  v5.40.0 — DE QR-CODE VAN EEN RONDE
    // ------------------------------------------------------------
    //  Wie een ronde-QR scant krijgt een sessie met de stempel `viaRonde`,
    //  met daarin het partijnummer. Zo iemand is een GAST: hij heeft geen
    //  clublid-account gebruikt, alleen een code die op tafel lag.
    //
    //  Hij mag precies één ding — de scores van díé ronde bijhouden, van alle
    //  spelers, want zo wordt er op de baan geteld (nagemeten: een ladderlid
    //  mag dat ook voor iedereen in zijn partij). Al het andere is dicht:
    //  andere partijen, de ladder, standen, profielen, uitslagen.
    //
    //  ⚠ Lezen mag hij wel wat elke ingelogde speler mag lezen. Dat is met
    //  opzet: hij moet het ladderdocument kunnen lezen om zijn eigen ronde te
    //  vinden (de lopende partijen staan daarin). Er staat geen geheim in —
    //  de QR-sleutel wordt uitgerekend en nergens bewaard, juist hierom.
    // ============================================================
    function viaRondeSessie() {
      return isIngelogd() && request.auth.token.get('viaRonde', '') != '';
    }
    function inEigenRonde(partijId) {
      return isIngelogd() && request.auth.token.get('viaRonde', '') == partijId;
    }
    // Eén naam voor "een sessie die maar één ding mag". Beide soorten zijn
    // binnengekomen op een gedeeld geheim in plaats van een eigen wachtwoord.
    function viaBeperkteSessie() {
      return viaToernooiPin() || viaRondeSessie();
    }
    // v4.2.0: puntensysteem — losstaand van rol, apart vlag op spelers/{uid}.
    // Alleen dit account mag de ruwe punten (score) lezen. Instellen kan
    // alleen handmatig in de Firebase console (eenmalige bootstrap), zodat
    // geen enkele client dit voor zichzelf kan aanzetten.
    function magPuntenZien() {
      return isIngelogd() &&
        getSpelerData(request.auth.uid) != null &&
        getSpelerData(request.auth.uid).puntenBeheerder == true;
    }
    function onlyHcp() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hcp']);
    }
    // v3.0.0-11: eerste login flow - speler mag hcp + eersteLogin flag samen zetten.
    // Alleen toegestaan als eersteLogin op false wordt gezet (nooit terug naar true).
    function isEersteLoginVoltooien() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hcp', 'eersteLogin'])
          && request.resource.data.eersteLogin == false;
    }
    function heeftGeldigeInvite(ladderId) {
      return exists(/databases/$(database)/documents/ladder/$('invite_' + ladderId)) &&
        get(/databases/$(database)/documents/ladder/$('invite_' + ladderId)).data.verloopt > request.time.toMillis() &&
        (!('maxGebruik' in get(/databases/$(database)/documents/ladder/$('invite_' + ladderId)).data) ||
         get(/databases/$(database)/documents/ladder/$('invite_' + ladderId)).data.get('gebruik', 0) <
         get(/databases/$(database)/documents/ladder/$('invite_' + ladderId)).data.maxGebruik);
    }
    // Check: ingelogde gebruiker is lid van ladder (via spelerIds[])
    function isInLadder(ladderId) {
      return isIngelogd() &&
        exists(/databases/$(database)/documents/ladders/$(ladderId)) &&
        get(/databases/$(database)/documents/ladders/$(ladderId)).data
          .get('spelerIds', []).hasAny([request.auth.uid]);
    }
    // Check: update is puur een teller-ophoging op het invite-doc (geen andere wijzigingen)
    function isInviteTellerUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gebruik'])
          && request.resource.data.gebruik == resource.data.get('gebruik', 0) + 1;
    }

    // --- spelers ----------------------------------------------
    // Bron van waarheid voor speler-identiteit
    match /spelers/{uid} {
      allow read:   if isIngelogd();
      // Create: zelf-registratie OF beheerder voegt speler handmatig toe via admin UI
      // v5.38.0: `!viaToernooiPin()` staat vooraan bij elke schrijfregel buiten
      // /toernooien. Zie viaToernooiPin() hierboven.
      allow create: if !viaBeperkteSessie() && (request.auth.uid == uid || isBeheerder());
      allow update: if !viaBeperkteSessie() &&
                       ((request.auth.uid == uid && (onlyHcp() || isEersteLoginVoltooien()))
                        || isBeheerder());
      allow delete: if !viaBeperkteSessie() && isBeheerder();
    }

    // --- ladders ----------------------------------------------
    // Ladder documenten: coordinator beheert, speler mag actieve partijen schrijven
    match /ladders/{ladderId} {
      allow read:  if isIngelogd();
      // v3.0.0-11.75: spelers die lid zijn van de ladder mogen ook schrijven
      // (nodig voor startPartij / bevestigUitslag). Eerder alleen coordinator,
      // waardoor schrijfpogingen van gewone spelers door Firestore werden
      // afgewezen en de partij nooit in de ronde verscheen.
      allow write: if !viaBeperkteSessie() && (isCoordinator()
                   || (isIngelogd() && isInLadder(ladderId))
                   || (isIngelogd() && heeftGeldigeInvite(ladderId)));

      // Stand per speler in deze ladder.
      // v5.0.0 (punt 3): rank is niet langer door gewone spelers te wijzigen.
      //
      // Tot v4.2.0 mocht ELK ladderlid de stand van ELKE speler overschrijven -
      // en juist die rank is wat iedereen ziet. Het slot op de punten-
      // subcollectie beschermde dus een getal dat niemand ziet, terwijl het
      // getal dat telt open stond.
      //
      // Wat wel moet blijven werken:
      //  - de Cloud Functions schrijven de rank na een partij (Admin SDK,
      //    omzeilt deze regels);
      //  - coordinator/beheerder beheren standen vanuit de admin-schermen
      //    (speler toevoegen/verwijderen, snapshot terugzetten, seizoen
      //    archiveren, toernooi-uitslag verwerken);
      //  - een speler synchroniseert zijn EIGEN handicap naar zijn eigen
      //    stand-document na de eerste login.
      // Alleen dat laatste is nog een speler-write, en die is beperkt tot het
      // hcp-veld op het eigen document via onlyHcp().
      match /standen/{uid} {
        allow read:   if isIngelogd();
        allow create: if !viaBeperkteSessie() && (request.auth.uid == uid || isCoordinator());
        allow update: if !viaBeperkteSessie() && (isCoordinator()
                     || (request.auth.uid == uid && onlyHcp()));
        allow delete: if !viaBeperkteSessie() && isCoordinator();
      }

      // v5.0.0 (punt 4): partijen als eigen documenten i.p.v. een array in het
      // ladderdocument. Metadata (baan, holes, spelers, matchups) staat in het
      // partij-document; de scores staan per speler in een eigen document.
      match /partijen/{partijId} {
        allow read:   if isIngelogd();
        // Aanmaken/wijzigen van een partij mag elk ladderlid (partij starten,
        // speler toevoegen/verwijderen) - net als voorheen op het ladderdoc.
        allow create, update: if !viaBeperkteSessie() && (isCoordinator() || isInLadder(ladderId));
        allow delete: if !viaBeperkteSessie() && (isCoordinator() || isInLadder(ladderId));

        // Scores: elke ingelogde speler die in de ladder zit mag schrijven.
        // Bewust niet beperkt tot de eigen uid: flightgenoten houden elkaars
        // kaart bij (zelfde reden als fix 7.8 bij de toernooiscores). Het
        // verschil met vroeger is dat je nu alleen het document van EEN speler
        // raakt, niet de scores van de hele ladder.
        match /scores/{spelerUid} {
          allow read:  if isIngelogd();
          // v5.40.0: een ronde-sessie mag hier schrijven, maar alleen in de
          // partij die in zijn eigen stempel staat. `partijId` komt uit het
          // pad, niet uit iets dat de client meestuurt.
          allow write: if inEigenRonde(partijId)
                       || (!viaBeperkteSessie() && (isCoordinator() || isInLadder(ladderId)));
        }
      }

      // v5.0.0 (punt 2): verwerkings-stempel per partij. Dit is de
      // idempotency-sleutel van verwerkPartijUitslag en tegelijk de
      // momentopname voor draaiPartijTerug. Uitsluitend server-side beschreven;
      // read is open voor ingelogde spelers zodat de app kan tonen wie een
      // uitslag heeft ingediend.
      match /verwerkt/{partijId} {
        allow read:  if isIngelogd();
        allow write: if false;
      }
      match /teruggedraaid/{partijId} {
        allow read:  if isCoordinator();
        allow write: if false;
      }

      // v4.2.0: puntensysteem — de ruwe score per speler. Read uitsluitend
      // voor het puntenBeheerder-account (technisch afgedwongen, niet alleen
      // verborgen in het scherm). Write staat voor NIEMAND rechtstreeks open:
      // alle wijzigingen lopen via de Cloud Functions verwerkPartijUitslag,
      // pasPuntenAan en herbereikenActiviteitDagelijks (Admin SDK, omzeilt
      // deze rules bewust). Zo kan geen enkele client — ook een gemanipuleerde
      // oude cache van de app niet — hier direct in schrijven.
      match /punten/{uid} {
        allow read:  if magPuntenZien();
        allow write: if false;
      }
    }

    // --- toernooien -------------------------------------------
    // Read publiek voor live meekijken; write alleen coordinator
    //
    // v5.10.0 - DE UITSLAGLINK IS ACHTERAF DICHT TE ZETTEN.
    // De coordinator kan `publiek: false` op een toernooi zetten. Dan weigert
    // de DATABASE het document aan iedereen die niet is ingelogd - niet alleen
    // de meekijkpagina. Anders zou de link "niet gevonden" tonen terwijl de
    // gegevens gewoon op te vragen bleven, en dat is geen dichte deur maar een
    // gordijn.
    //
    // `get('publiek', true)` betekent: openbaar tenzij uitdrukkelijk dichtgezet.
    // Alle bestaande toernooien hebben het veld niet en blijven dus zichtbaar.
    //
    // ⚠ NIET `resource.data.publiek != false` schrijven. Een veld opvragen dat
    // niet bestaat is in Firestore-regels een FOUT, geen lege waarde - en een
    // regel die een fout geeft weigert. Daarmee was in een klap elk bestaand
    // toernooi onzichtbaar voor het live meekijken. De regeltest ving dat op
    // (`toernooi is publiek leesbaar` sloeg meteen om), niet het toeval.
    //
    // LET OP bij een zoekopdracht (list). Firestore laat een hele zoekopdracht
    // vallen zodra ook maar EEN gevonden document niet gelezen mag worden.
    // toernooi-live.html zoekt zonder link-parameter naar het actieve toernooi.
    // Daarom mag de app `publiek: false` alleen zetten op een toernooi dat NIET
    // meer actief is - dan komt zo'n document in die zoekopdracht nooit voor.
    // Die grendel zit in js/toernooi.js; hier staat waarom hij nodig is.
    match /toernooien/{doc} {
      allow read:  if isIngelogd() || resource.data.get('publiek', true) == true;
      allow write: if isCoordinator();

      // v5.10.0: het wachtwoord voor de gastlogins van dit toernooi. Een
      // ONDERLIGGENDE map erft de regels van het document er NIET van - daarom
      // kan dit geheim blijven terwijl het toernooi zelf openbaar leesbaar is.
      // Alleen de coordinator komt erbij.
      match /beheer/{stuk} {
        allow read, write: if isCoordinator();
      }

      // v3.0.0-11.106: live-scores subcollectie - spelers schrijven scores hier.
      // v4.0.1 (fix 7.8): elke ingelogde speler mag live-scores schrijven, zodat
      // een speler de scores van zijn flightgenoten kan invoeren (kaart bijhouden
      // voor de hele flight). Voorheen blokkeerde de regel alles behalve de eigen
      // uid of de coordinator - waardoor alleen de eigen score doorkwam.
      // Read publiek zodat toernooi-live.html real-time scores kan tonen.
      //
      // v5.11.0 - DRIE LAGEN IN EEN DOCUMENT.
      //   dagen        de speler zelf
      //   markerDagen  een medespeler uit zijn flight
      //   beheerDagen  de wedstrijdleiding - en die is beslissend
      //
      // De eerste twee mag elke ingelogde speler schrijven: de app bepaalt wie
      // in welke kolom mag typen, en een club waarvan iedereen een eigen inlog
      // heeft is geen plek om dat met databaseregels dicht te timmeren. De DERDE
      // laag is wel afgeschermd: die zet een hole definitief op slot voor de
      // speler en zijn flight, dus wie hem kan schrijven kan een uitslag
      // bepalen.
      //
      // v5.43.0: de vaste marker is vervallen - wie in de flight zit mag in elke
      // kolom van die flight typen. Deze regels hoefden daarvoor NIET te
      // veranderen: ze lieten elke ingelogde speler deze laag al schrijven.
      //
      // ⚠ hasAny() op affectedKeys() is hier de juiste vraag: "verandert deze
      // schrijfactie beheerDagen?" Een create heeft geen resource.data, vandaar
      // de aparte tak.
      //
      // ⚠ v5.40.0: `!viaRondeSessie()` erbij. Wie met de QR van een LADDERRONDE
      // binnenkwam is hier ingelogd, en `isIngelogd()` alleen zou hem dus
      // toernooiscores laten schrijven van een toernooi waar hij niets mee te
      // maken heeft. De toernooi-pincode mag hier juist wél schrijven — dat is
      // precies waarvoor die sessie bestaat.
      match /live/{uid} {
        allow read:   if true;
        allow create: if isIngelogd() && !viaRondeSessie() &&
                        (!request.resource.data.keys().hasAny(['beheerDagen']) || isCoordinator());
        allow update: if isIngelogd() && !viaRondeSessie() &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['beheerDagen'])
                         || isCoordinator());
        allow delete: if isCoordinator();
      }
    }

    // --- uitslagen --------------------------------------------
    // Scorekaarten van afgelopen partijen (30 dagen bewaard)
    match /uitslagen/{doc} {
      allow read:   if isIngelogd();
      allow create: if !viaBeperkteSessie() && isIngelogd();
      // Update/delete alleen coordinator - voorkomt dat speler andermans uitslag overschrijft
      allow update, delete: if !viaBeperkteSessie() && isCoordinator();
    }

    // --- snapshots --------------------------------------------
    // Volledige ladderdump voor recovery - bevat speler-identiteit.
    // Read alleen coord (bevat veel speler-data). Write mag iedere ingelogde speler
    // (auto-snapshot na partij-bevestiging wordt door de speler getriggerd).
    match /snapshots/{doc} {
      allow read:   if isCoordinator();
      allow create: if !viaBeperkteSessie() && isIngelogd();
      allow update, delete: if !viaBeperkteSessie() && isCoordinator();
    }

    // v5.40.0: ladder/qrGeheim draagt het geheim waaruit de QR-sleutels worden
    // uitgerekend. Volledig dicht, net als ladder/watchPins — alleen de Cloud
    // Functions komen erbij via de Admin SDK. Zie de read-regel hieronder.
    // --- ladder/{doc} -----------------------------------------
    // Meerdere singleton-documents onder /ladder - splitsen per doc-type
    match /ladder/{doc} {
      // Read: ingelogde spelers voor alle app-data; invite-docs mogen ongeauthenticeerd
      // gelezen worden (checkInviteLink doet dit voor login).
      //
      // v5.0.0 - BELANGRIJK: in Firestore worden meerdere `allow read`-regels
      // met OR gecombineerd. Een latere, striktere regel maakt een eerdere
      // ruimere regel dus NIET ongedaan. Daarom moeten de gevoelige documenten
      // hier expliciet worden uitgezonderd; een aparte regel verderop volstaat
      // niet.
      //
      // Uitgezonderd:
      //  - watchPins / watchPinPogingen: alleen de Cloud Functions (punt 1)
      //  - config: bevat initieelWachtwoord. Dit stond t/m v4.2.0 leesbaar voor
      //    ELKE ingelogde speler, ondanks de beheerder-only regel verderop -
      //    precies door dit OR-gedrag. Elke speler kon dus het initiele
      //    wachtwoord van alle nieuwe accounts opvragen.
      // ⚠ v5.40.0: `qrGeheim` staat in dezelfde rij uitzonderingen. Daaruit
      // worden ALLE ronde-sleutels uitgerekend; wie dat geheim leest kan zich
      // in elke lopende ronde naar binnen scannen. Alleen de Cloud Functions
      // komen erbij, via de Admin SDK.
      allow read: if (isIngelogd()
                      && doc != 'watchPins'
                      && doc != 'watchPinPogingen'
                      && doc != 'qrGeheim'
                      && doc != 'config')
                   || doc.matches('invite_.*');

      // archief: seizoen-historiek - alleen coordinator schrijft
      allow write: if doc == 'archief' && isCoordinator();

      // uitdagingen: lijst met uitdagingen - iedere ingelogde speler mag wijzigen
      // (eigen uitdagingen sturen, accepteren, weigeren, verwijderen)
      allow write: if doc == 'uitdagingen' && isIngelogd() && !viaBeperkteSessie();

      // ladderVolgorde: display-volgorde van ladders - alleen coordinator
      allow write: if doc == 'ladderVolgorde' && isCoordinator();

      // banen: custom banen - iedere ingelogde speler mag toevoegen/verwijderen
      allow write: if doc == 'banen' && isIngelogd() && !viaBeperkteSessie();

      // state: legacy main-state doc - alleen coordinator (wordt uitgefaseerd)
      allow write: if doc == 'state' && isCoordinator();

      // users: legacy users doc - read-only voor backward compat (wordt uitgefaseerd)
      allow write: if doc == 'users' && isCoordinator();

      // toernooi: legacy singleton - alleen coordinator
      allow write: if doc == 'toernooi' && isCoordinator();

      // config: app-configuratie (o.a. initieelWachtwoord) - alleen beheerder
      // v3.0.0-11.60: wachtwoord is niet meer hardcoded in broncode
      allow read:  if doc == 'config' && isBeheerder();
      allow write: if doc == 'config' && isBeheerder();

      // watchPins: v5.0.0 VOLLEDIG DICHT (punt 1).
      // Tot v4.2.0: `allow read: if true` op een document met Firebase
      // refreshTokens erin. Een refreshToken is geen tijdelijk sleuteltje maar
      // een permanente loper waarmee je onbeperkt nieuwe idTokens maakt. Omdat
      // het project-ID in de broncode staat, kon iedereen dat document met een
      // enkele ongeauthenticeerde request ophalen en inloggen als elke speler
      // die ooit het rondescherm had geopend - beheerder inbegrepen.
      // Nu: alleen gehashte, eenmalige PIN's met 15 minuten geldigheid, en
      // uitsluitend benaderd door de Cloud Functions maakWatchPin en
      // wisselWatchPin via de Admin SDK. Geen enkele client leest of schrijft
      // hier nog. watchPinPogingen is de bijbehorende foutteller.
      // Er staat hier bewust GEEN allow-regel voor watchPins/watchPinPogingen:
      // in Firestore is "geen enkele regel die toestaat" gelijk aan weigeren.
      // Een `allow ...: if false` toevoegen zou niets doen (regels worden met
      // OR gecombineerd), dus het weren gebeurt in de read-regel hierboven.

      // invite_{ladderId}: genereren alleen coordinator; teller ophogen iedere ingelogde
      allow create: if !viaBeperkteSessie() && doc.matches('invite_.*') && isCoordinator();
      allow update: if !viaBeperkteSessie() && doc.matches('invite_.*') && (
                       isCoordinator() ||
                       (isIngelogd() && isInviteTellerUpdate())
                     );
      allow delete: if !viaBeperkteSessie() && doc.matches('invite_.*') && isCoordinator();
    }

    // --- Alle overige paden: dicht ----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
